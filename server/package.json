{
  "name": "ai-coding-lessons-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the ai-coding-lessons repository (read-only)",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test \"dist/test/*.test.js\"",
    "start": "node dist/src/index.js",
    "start:http": "node dist/src/index.js --http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
